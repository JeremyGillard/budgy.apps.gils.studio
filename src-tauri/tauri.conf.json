  "productName": "Budgy",
  "version": "0.1.0",
  "identifier": "studio.gils.apps.budgy",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Budgy",
